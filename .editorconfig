root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.html]
indent_size = 2
tab_width = 2
ij_continuation_indent_size = 2

# Don't force attribute chopping; your manual breaks are preserved (keep_line_breaks)
ij_html_attribute_wrap = normal
ij_html_keep_line_breaks = true
ij_html_keep_line_breaks_in_text = true
ij_html_keep_blank_lines = 1

# WHEN a tag is multiline: tag name alone on line 1, attrs indented +2, /> on its own line
ij_html_new_line_before_first_attribute = when_multiline
ij_html_new_line_after_last_attribute = when_multiline
ij_html_align_attributes = false

# <example /> with the space
ij_html_space_inside_empty_tag = true

# Uniform 2-space indent everywhere, incl. body/thead children and Angular blocks
ij_html_do_not_indent_children_of_tags = none

ij_html_quote_style = double
ij_html_enforce_quotes = true
ij_html_space_around_equality_in_attribute = false
ij_html_space_after_tag_name = false
ij_html_text_wrap = normal
ij_html_align_text = false

# {{ wow }} with spaces — TypeScript key, but it must apply to the template files
ij_typescript_spaces_within_interpolation_expressions = true

[*.ts]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = off
ij_continuation_indent_size = 2
ij_visual_guides = 80, 120
ij_wrap_on_typing = false
ij_smart_tabs = false

# Alignment
ij_typescript_align_imports = false
ij_typescript_align_multiline_array_initializer_expression = false
ij_typescript_align_multiline_binary_operation = false
ij_typescript_align_multiline_chained_methods = true
ij_typescript_align_multiline_extends_list = false
ij_typescript_align_multiline_for = false
ij_typescript_align_multiline_parameters = true
ij_typescript_align_multiline_parameters_in_calls = false
ij_typescript_align_multiline_ternary_operation = false
ij_typescript_align_object_properties = 0
ij_typescript_align_union_types = true
ij_typescript_align_var_statements = 0

# Wrapping
ij_typescript_array_initializer_new_line_after_left_brace = false
ij_typescript_array_initializer_right_brace_on_new_line = false
ij_typescript_array_initializer_wrap = normal
ij_typescript_assignment_wrap = normal
# CHANGED false -> true: your style puts the operator at line start:
#   this.disabled()
#   || this._formDisabled()
ij_typescript_binary_operation_sign_on_next_line = true
ij_typescript_binary_operation_wrap = normal
ij_typescript_call_parameters_new_line_after_left_paren = false
ij_typescript_call_parameters_right_paren_on_new_line = false
ij_typescript_call_parameters_wrap = normal
ij_typescript_chained_call_dot_on_new_line = true
ij_typescript_comma_on_new_line = false
ij_typescript_enforce_trailing_comma = whenmultiline
ij_typescript_enum_constants_wrap = on_every_item
# CHANGED on_every_item -> off: `implements A, B` stays inline in your code
ij_typescript_extends_keyword_wrap = off
ij_typescript_extends_list_wrap = off
ij_typescript_for_statement_new_line_after_left_paren = false
ij_typescript_for_statement_right_paren_on_new_line = false
ij_typescript_for_statement_wrap = off
ij_typescript_imports_wrap = off
ij_typescript_method_call_chain_wrap = normal
ij_typescript_method_parameters_new_line_after_left_paren = false
ij_typescript_method_parameters_right_paren_on_new_line = false
# CHANGED split_into_lines -> off: split_into_lines forces EVERY declaration's
# params onto separate lines; your code always keeps them on one line
ij_typescript_method_parameters_wrap = off
ij_typescript_parentheses_expression_new_line_after_left_paren = false
ij_typescript_parentheses_expression_right_paren_on_new_line = false
ij_typescript_place_assignment_sign_on_next_line = false
ij_typescript_prefer_parameters_wrap = true
ij_typescript_ternary_operation_signs_on_next_line = false
# CHANGED split_into_lines -> off: your ternaries are inline
# (checkbox.checked ? 'true' : 'false')
ij_typescript_ternary_operation_wrap = off
ij_typescript_union_types_wrap = on_every_item
ij_typescript_var_declaration_wrap = normal
ij_typescript_wrap_comments = true
ij_typescript_keep_line_breaks = true
ij_typescript_keep_simple_blocks_in_one_line = true
ij_typescript_keep_simple_methods_in_one_line = true

# Braces
ij_typescript_block_brace_style = end_of_line
ij_typescript_class_brace_style = end_of_line
ij_typescript_function_expression_brace_style = end_of_line
ij_typescript_method_brace_style = end_of_line
ij_typescript_do_while_brace_force = never
ij_typescript_for_brace_force = never
ij_typescript_if_brace_force = never
ij_typescript_while_brace_force = never
ij_typescript_catch_on_new_line = false
ij_typescript_else_on_new_line = false
ij_typescript_finally_on_new_line = false
ij_typescript_while_on_new_line = false
# CHANGED false -> true: false rewrites `} else if (x) {` into a nested if
# inside the else block
ij_typescript_special_else_if_treatment = true

# Blank lines and indentation
ij_typescript_blank_lines_after_imports = 1
ij_typescript_blank_lines_around_class = 1
ij_typescript_blank_lines_around_field = 1
ij_typescript_blank_lines_around_field_in_interface = 0
ij_typescript_blank_lines_around_function = 1
ij_typescript_blank_lines_around_method = 1
ij_typescript_blank_lines_around_method_in_interface = 0
ij_typescript_keep_blank_lines_in_code = 1
ij_typescript_keep_indents_on_empty_lines = false
ij_typescript_indent_case_from_switch = true
ij_typescript_indent_chained_calls = true
ij_typescript_indent_package_children = 1
ij_typescript_use_chained_calls_group_indents = true

# Comments
ij_typescript_block_comment_add_space = true
ij_typescript_block_comment_at_first_column = false
ij_typescript_line_comment_add_space = true
ij_typescript_line_comment_at_first_column = false
ij_typescript_keep_first_column_comment = false
ij_typescript_reformat_c_style_comments = true
ij_typescript_jsdoc_include_types = true

# Spaces
ij_typescript_space_before_async_arrow_lparen = true
ij_typescript_space_before_catch_keyword = true
ij_typescript_space_before_catch_left_brace = true
ij_typescript_space_before_catch_parentheses = true
ij_typescript_space_before_class_lbrace = true
ij_typescript_space_before_class_left_brace = true
ij_typescript_space_before_colon = true
ij_typescript_space_before_comma = false
ij_typescript_space_before_do_left_brace = true
ij_typescript_space_before_else_keyword = true
ij_typescript_space_before_else_left_brace = true
ij_typescript_space_before_finally_keyword = true
ij_typescript_space_before_finally_left_brace = true
ij_typescript_space_before_for_left_brace = true
ij_typescript_space_before_for_parentheses = true
ij_typescript_space_before_for_semicolon = false
ij_typescript_space_before_function_left_parenth = true
ij_typescript_space_before_generator_mult = false
ij_typescript_space_before_if_left_brace = true
ij_typescript_space_before_if_parentheses = true
ij_typescript_space_before_method_call_parentheses = false
ij_typescript_space_before_method_left_brace = true
ij_typescript_space_before_method_parentheses = false
ij_typescript_space_before_property_colon = false
ij_typescript_space_before_quest = true
ij_typescript_space_before_switch_left_brace = true
ij_typescript_space_before_switch_parentheses = true
ij_typescript_space_before_try_left_brace = true
ij_typescript_space_before_type_colon = false
ij_typescript_space_before_unary_not = false
ij_typescript_space_before_while_keyword = true
ij_typescript_space_before_while_left_brace = true
ij_typescript_space_before_while_parentheses = true
ij_typescript_space_after_colon = true
ij_typescript_space_after_comma = true
ij_typescript_space_after_dots_in_rest_parameter = false
ij_typescript_space_after_generator_mult = true
ij_typescript_space_after_property_colon = true
ij_typescript_space_after_quest = true
ij_typescript_space_after_type_colon = true
ij_typescript_space_after_unary_not = false
ij_typescript_spaces_around_additive_operators = true
ij_typescript_spaces_around_arrow_function_operator = true
ij_typescript_spaces_around_assignment_operators = true
ij_typescript_spaces_around_bitwise_operators = true
ij_typescript_spaces_around_equality_operators = true
ij_typescript_spaces_around_logical_operators = true
ij_typescript_spaces_around_multiplicative_operators = true
ij_typescript_spaces_around_relational_operators = true
ij_typescript_spaces_around_shift_operators = true
ij_typescript_spaces_around_unary_operator = false
# CHANGED true -> false: true produces `[ Foo, Bar ]` on single-line arrays;
# no evidence of that style in your samples. Flip back if you do want it.
ij_typescript_spaces_within_array_initializer_brackets = false
ij_typescript_spaces_within_brackets = false
ij_typescript_spaces_within_catch_parentheses = false
ij_typescript_spaces_within_for_parentheses = false
ij_typescript_spaces_within_if_parentheses = false
ij_typescript_spaces_within_imports = true
ij_typescript_spaces_within_interpolation_expressions = false
ij_typescript_spaces_within_method_call_parentheses = false
ij_typescript_spaces_within_method_parentheses = false
ij_typescript_spaces_within_object_literal_braces = true
ij_typescript_spaces_within_object_type_braces = true
ij_typescript_spaces_within_parentheses = false
ij_typescript_spaces_within_switch_parentheses = false
ij_typescript_spaces_within_type_assertion = false
ij_typescript_spaces_within_union_types = true
ij_typescript_spaces_within_while_parentheses = false

# Punctuation and code generation
ij_typescript_use_double_quotes = false
ij_typescript_force_quote_style = true
ij_typescript_use_semicolon_after_statement = true
ij_typescript_force_semicolon_style = true
ij_typescript_prefer_as_type_cast = true
ij_typescript_use_public_modifier = true
ij_typescript_file_name_style = pascal_case

# Imports
ij_typescript_import_merge_members = true
# CHANGED true -> false: your imports use relative paths ('../../../types/...')
ij_typescript_import_prefer_absolute_path = false
ij_typescript_import_sort_members = true
ij_typescript_import_sort_module_name = true
ij_typescript_import_use_node_resolution = true
ij_typescript_use_path_mapping = always

[{*.component.ts,*.store.ts,*.service.ts}]
ij_typescript_file_name_style = lisp_case

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# UTF-8 without BOM. A leading BOM breaks strict JSON parsers
# (e.g. semantic-release reading .releaserc.json).
[*.json]
charset = utf-8